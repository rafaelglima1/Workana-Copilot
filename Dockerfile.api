FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/FreelaHunter.Domain/FreelaHunter.Domain.csproj src/FreelaHunter.Domain/
COPY src/FreelaHunter.Contracts/FreelaHunter.Contracts.csproj src/FreelaHunter.Contracts/
COPY src/FreelaHunter.Application/FreelaHunter.Application.csproj src/FreelaHunter.Application/
COPY src/FreelaHunter.Infrastructure/FreelaHunter.Infrastructure.csproj src/FreelaHunter.Infrastructure/
COPY src/FreelaHunter.Api/FreelaHunter.Api.csproj src/FreelaHunter.Api/
RUN dotnet restore src/FreelaHunter.Api/FreelaHunter.Api.csproj

COPY src/ src/
RUN dotnet publish src/FreelaHunter.Api/FreelaHunter.Api.csproj -c Release -o /app/api --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/api .
EXPOSE 5092
ENV ASPNETCORE_URLS=http://+:5092
ENTRYPOINT ["dotnet", "FreelaHunter.Api.dll"]
