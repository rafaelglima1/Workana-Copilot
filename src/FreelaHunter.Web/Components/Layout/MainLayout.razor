@inherits LayoutComponentBase

<div class="page">
    <nav class="sidebar">
        <div class="sidebar-brand">
            <a href="/dashboard" class="brand-link">
                <span class="brand-icon">FH</span>
                <span class="brand-text">FreelaHunter</span>
            </a>
        </div>
        <div class="nav-menu">
            <div class="nav-section">Principal</div>
            <NavLink href="/dashboard" class="nav-item" Match="NavLinkMatch.All">
                <span class="nav-icon">📊</span>
                <span class="nav-text">Dashboard</span>
            </NavLink>
            <NavLink href="/inbox" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">📥</span>
                <span class="nav-text">Inbox</span>
            </NavLink>

            <div class="nav-section">Dados</div>
            <NavLink href="/scraper" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">🕷️</span>
                <span class="nav-text">Scraper</span>
            </NavLink>
            <NavLink href="/opportunities/create" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">➕</span>
                <span class="nav-text">Nova Oportunidade</span>
            </NavLink>
            <NavLink href="/import" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">📄</span>
                <span class="nav-text">Importar JSON</span>
            </NavLink>

            <div class="nav-section">Sistema</div>
            <NavLink href="/profile" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">⚙️</span>
                <span class="nav-text">Configurações</span>
            </NavLink>
        </div>
        <div class="sidebar-footer">
            <small>v1.0</small>
        </div>
    </nav>

    <main>
        <div class="content">
            @Body
        </div>
    </main>
</div>
