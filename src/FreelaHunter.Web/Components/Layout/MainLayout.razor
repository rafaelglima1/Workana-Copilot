@inherits LayoutComponentBase

<div class="page">
    <nav class="sidebar">
        <div class="sidebar-brand">
            <a href="/" class="brand-link">
                <span class="brand-icon">FH</span>
                <span class="brand-text">FreelaHunter</span>
            </a>
        </div>
        <div class="nav-menu">
            <NavLink href="/" class="nav-item" Match="NavLinkMatch.All">
                <span class="nav-icon">🏠</span>
                <span class="nav-text">Home</span>
            </NavLink>
            <NavLink href="/inbox" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">📥</span>
                <span class="nav-text">Inbox</span>
            </NavLink>
            <NavLink href="/opportunities/create" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">➕</span>
                <span class="nav-text">Nova Oportunidade</span>
            </NavLink>
            <NavLink href="/profile" class="nav-item" Match="NavLinkMatch.Prefix">
                <span class="nav-icon">👤</span>
                <span class="nav-text">Meu Perfil</span>
            </NavLink>
        </div>
    </nav>

    <main>
        <div class="content">
            @Body
        </div>
    </main>
</div>
