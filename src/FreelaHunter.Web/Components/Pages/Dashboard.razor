@page "/dashboard"
@inject FreelaHunterApiClient Api
@rendermode InteractiveServer

<PageTitle>Dashboard - FreelaHunter</PageTitle>

<h1 class="page-title">📊 Dashboard</h1>

@if (_loading)
{
    <div class="text-center py-5">
        <div class="spinner-border text-primary"></div>
    </div>
}
else
{
    <div class="row mb-4">
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-primary">@_total</h2>
                    <p class="text-muted mb-0">Total de Oportunidades</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-success">@_prioritize</h2>
                    <p class="text-muted mb-0">Priorizar</p>
                </div>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card text-center">
                <div class="card-body">
                    <h2 class="text-info">@_apply</h2>
                    <p class="text-muted mb-0">Aplicar</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mb-3">
        <a href="/inbox" class="btn btn-primary">📥 Ver Inbox</a>
        <a href="/import" class="btn btn-outline-secondary">📥 Importar</a>
        <a href="/opportunities/create" class="btn btn-outline-secondary">➕ Criar</a>
        <a href="/profile" class="btn btn-outline-secondary">👤 Perfil</a>
    </div>
}

@code {
    private bool _loading = true;
    private int _total;
    private int _prioritize;
    private int _apply;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var result = await Api.GetInboxAsync(pageSize: 1);
            _total = result?.TotalCount ?? 0;

            var priorize = await Api.GetInboxAsync(pageSize: 1, recommendation: "Prioritize");
            _prioritize = priorize?.TotalCount ?? 0;

            var applyResult = await Api.GetInboxAsync(pageSize: 1, recommendation: "Apply");
            _apply = applyResult?.TotalCount ?? 0;
        }
        catch
        {
            _total = 0;
        }

        _loading = false;
    }
}
