FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/FreelaHunter.Domain/FreelaHunter.Domain.csproj src/FreelaHunter.Domain/
COPY src/FreelaHunter.Contracts/FreelaHunter.Contracts.csproj src/FreelaHunter.Contracts/
COPY src/FreelaHunter.Application/FreelaHunter.Application.csproj src/FreelaHunter.Application/
COPY src/FreelaHunter.Infrastructure/FreelaHunter.Infrastructure.csproj src/FreelaHunter.Infrastructure/
COPY src/FreelaHunter.Web/FreelaHunter.Web.csproj src/FreelaHunter.Web/
RUN dotnet restore src/FreelaHunter.Web/FreelaHunter.Web.csproj

COPY src/ src/
RUN dotnet publish src/FreelaHunter.Web/FreelaHunter.Web.csproj -c Release -o /app/web --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0
WORKDIR /app
COPY --from=build /app/web .
EXPOSE 5270
ENV ASPNETCORE_URLS=http://+:5270
ENV ApiUrl=http://api:5092
ENTRYPOINT ["dotnet", "FreelaHunter.Web.dll"]
